# Variáveis do SERVIDOR (funções em api/). Configure na Vercel:
# Project Settings → Environment Variables. Nunca use o prefixo VITE_ nelas:
# o prefixo VITE_ embute o valor no código que vai para o navegador.

# Chave da API do Asaas (Minha Conta → Integrações). Comece pela do sandbox.
ASAAS_API_KEY=
# "sandbox" para testes; "producao" para cobrar de verdade.
ASAAS_AMBIENTE=sandbox
# Texto longo e aleatório, o mesmo informado ao cadastrar o webhook no Asaas.
ASAAS_WEBHOOK_TOKEN=
# JSON inteiro da conta de serviço do Firebase (Configurações do projeto →
# Contas de serviço → Gerar nova chave privada), em uma linha.
FIREBASE_SERVICE_ACCOUNT=
